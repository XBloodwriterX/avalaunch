{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for Avalaunch main window",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://*/*",
      "https://*",
      "http://*/*",
      "http://*"
    ]
  },
  "permissions": [
    "core:default",
    "opener:default",
    "shell:default",
    "window-state:default",
    "notification:default",
    "global-shortcut:default"
  ]
}
